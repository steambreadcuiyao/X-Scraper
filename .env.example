# X Scraper — 浏览器配置
# 复制为 .env 后修改

# 浏览器模式 (三选一):
#   chrome         — Playwright 内置 Chromium 无头模式 (服务器适用)
#   chrome-visible — 系统 Chrome 可视模式 (本地开发, 反爬最强)
#   cdp            — 连接已运行的 Chrome (用你的真实浏览器, 最推荐)
BROWSER_MODE=chrome

# CDP 连接端口 (BROWSER_MODE=cdp 时使用)
# 先启动 chrome.exe --remote-debugging-port=9222
CDP_PORT=9222

# 代理 (可选)
X_SCRAPER_PROXY=

# 服务器端口
PORT=8765
